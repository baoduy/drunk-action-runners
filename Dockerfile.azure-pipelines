# Azure Pipelines self-hosted agent.
# Built for the target platform (no --platform=$BUILDPLATFORM: that pin makes
# every arch tag contain build-host binaries).
FROM ubuntu:24.04

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    AZP_WORK=/azp/_work

# libicu74 matches ubuntu 24.04 (noble); bump it with the base image.
# Microsoft's apt key is stored ASCII-armored so gnupg is not needed at build time.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        iputils-ping \
        jq \
        libatomic1 \
        libicu74 \
        lsb-release && \
    install -d -m 0755 /etc/apt/keyrings && \
    curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
        -o /etc/apt/keyrings/microsoft.asc && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/microsoft.asc] https://packages.microsoft.com/repos/azure-cli/ $(. /etc/os-release && echo "$VERSION_CODENAME") main" \
        > /etc/apt/sources.list.d/azure-cli.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends azure-cli && \
    apt-get purge -y --auto-remove && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /usr/share/doc/* /usr/share/man/* && \
    find /opt/az -name '__pycache__' -type d -prune -exec rm -rf {} + 2>/dev/null || true

# Non-root: the agent only needs to own /azp.
RUN useradd --create-home --shell /bin/bash agent && \
    mkdir -p "$AZP_WORK" && \
    chown -R agent:agent /azp

WORKDIR /azp

COPY --chown=agent:agent --chmod=0755 azure-pipelines-agent/start.sh .

USER agent

ENTRYPOINT [ "./start.sh" ]
