# GitHub Actions self-hosted runner.
# Pinned base; see https://github.com/actions/runner/releases
# No --platform=$BUILDPLATFORM: that pin makes every arch tag contain
# build-host binaries.
FROM ghcr.io/actions/actions-runner:2.337.0

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

USER root

# Microsoft's apt key is stored ASCII-armored so gnupg is not needed at build time.
RUN export DEBIAN_FRONTEND=noninteractive && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        jq \
        libatomic1 && \
    install -d -m 0755 /etc/apt/keyrings && \
    curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
        -o /etc/apt/keyrings/microsoft.asc && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/microsoft.asc] https://packages.microsoft.com/repos/azure-cli/ $(. /etc/os-release && echo "$VERSION_CODENAME") main" \
        > /etc/apt/sources.list.d/azure-cli.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends azure-cli && \
    apt-get purge -y --auto-remove && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /usr/share/doc/* /usr/share/man/* && \
    find /opt/az -name '__pycache__' -type d -prune -exec rm -rf {} + 2>/dev/null || true

COPY --chown=runner:runner --chmod=0755 github-actions-runner/entrypoint.sh ./entrypoint.sh

USER runner

ENTRYPOINT ["./entrypoint.sh"]
